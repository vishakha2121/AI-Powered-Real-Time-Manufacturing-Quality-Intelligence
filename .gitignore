node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite
dist/
dist-ssr/
*.local
.vite/

# Production build
build/
out/

# Package managers
.pnpm-store/
.yarn/
.yarnrc.yml
package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing
coverage/
.nyc_output/
*.lcov

# ESLint / Prettier cache
.eslintcache
.prettiercache

# --------------------------------------------
# 🔐 Environment Variables (SECRET)
# --------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# --------------------------------------------
# 🗄️ Database
# --------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
database/*.db
backend/database/*.db
database/backups/*.sql

# --------------------------------------------
# 🤖 ML Models (Large Files)
# --------------------------------------------
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pth
*.pt
*.onnx
*.tflite
*.pb
saved_models/
models/**/*.h5
models/**/*.pkl
backend/app/ml/vision/saved_models/*.h5
backend/app/ml/timeseries/saved_models/*.pkl

# --------------------------------------------
# 📊 Data & Logs
# --------------------------------------------
logs/
*.log
*.csv
!data/**/*.csv
data/raw/
data/processed/
temp/
tmp/
uploads/
outputs/
results/

# --------------------------------------------
# 🖼️ Media (Optional — uncomment if needed)
# --------------------------------------------
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.mp4
# *.avi

# --------------------------------------------
# 🖥️ OS Files
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------
# 💻 IDE / Editor
# --------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.code-workspace

