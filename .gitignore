# ============================================
# 🛡️ QualityGuardian AI - .gitignore
# ============================================

# --------------------------------------------
# 🐍 Python
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
.env/
virtualenv/
pyenv/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# PyCharm / VS Code
.idea/
.vscode/
*.swp
*.swo
*~

# --------------------------------------------
# 📦 Node / React / Vite
# --------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite
dist/
dist-ssr/
*.local
.vite/

# Production build
build/
out/

# Package managers
.pnpm-store/
.yarn/
.yarnrc.yml
package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing
coverage/
.nyc_output/
*.lcov

# ESLint / Prettier cache
.eslintcache
.prettiercache

# --------------------------------------------
# 🔐 Environment Variables (SECRET)
# --------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# --------------------------------------------
# 🗄️ Database
# --------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
database/*.db
backend/database/*.db
database/backups/*.sql

# --------------------------------------------
# 🤖 ML Models (Large Files)
# --------------------------------------------
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pth
*.pt
*.onnx
*.tflite
*.pb
saved_models/
models/**/*.h5
models/**/*.pkl
backend/app/ml/vision/saved_models/*.h5
backend/app/ml/timeseries/saved_models/*.pkl

# --------------------------------------------
# 📊 Data & Logs
# --------------------------------------------
logs/
*.log
*.csv
!data/**/*.csv
data/raw/
data/processed/
temp/
tmp/
uploads/
outputs/
results/

# --------------------------------------------
# 🖼️ Media (Optional — uncomment if needed)
# --------------------------------------------
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.mp4
# *.avi

# --------------------------------------------
# 🖥️ OS Files
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------
# 💻 IDE / Editor
# --------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.code-workspace

# --------------------------------------------
# 🧪 Testing / Coverage
# --------------------------------------------
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.cache

# --------------------------------------------
# 🏗️ Build / Misc
# --------------------------------------------
*.bak
*.backup
*.old
*.orig
*.tmp
*.swp
*~
.DS_Store

# --------------------------------------------
# 🐳 Docker (if using locally)
# --------------------------------------------
docker-compose.override.yml
.docker/

# --------------------------------------------
# 📄 Others
# --------------------------------------------
*.pid
*.seed
*.pid.lock
.grunt/
.node_repl_history
.repl_history

# --------------------------------------------
# 🔒 Secrets / Keys
# --------------------------------------------
*.pem
*.key
*.crt
*.cert
secrets.json
credentials.json
service-account.json

# --------------------------------------------
# 🎬 Demo / Screenshots (optional)
# --------------------------------------------
# docs/demo.gif
# docs/screenshots/*.png
